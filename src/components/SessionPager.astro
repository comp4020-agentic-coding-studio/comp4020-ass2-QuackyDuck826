---
/**
 * Previous/next links between tutorial sessions, ordered by week.
 * Renders whichever side exists — the first session has no previous,
 * the last has no next.
 */
import type { CollectionEntry } from "astro:content";
import { withBase } from "astro-theme-university/url";

interface Props {
  session: CollectionEntry<"sessions">;
  sessions: CollectionEntry<"sessions">[];
}

const { session, sessions } = Astro.props;
const ordered = [...sessions].sort((a, b) => a.data.week - b.data.week);
const index = ordered.findIndex((s) => s.id === session.id);
const previous = index > 0 ? ordered[index - 1] : undefined;
const next = index < ordered.length - 1 ? ordered[index + 1] : undefined;
---

{
  (previous || next) && (
    <nav class="session-pager" aria-label="Adjacent tutorial sessions">
      <div class="session-pager-side">
        {previous && (
          <a href={withBase(`/sessions/${previous.id}/`)} rel="prev">
            <span class="session-pager-direction">&larr; Previous</span>
            <span class="session-pager-title">
              Week {previous.data.week}: {previous.data.title}
            </span>
          </a>
        )}
      </div>
      <div class="session-pager-side session-pager-side-next">
        {next && (
          <a href={withBase(`/sessions/${next.id}/`)} rel="next">
            <span class="session-pager-direction">Next &rarr;</span>
            <span class="session-pager-title">
              Week {next.data.week}: {next.data.title}
            </span>
          </a>
        )}
      </div>
    </nav>
  )
}

<style>
  .session-pager {
    margin-block-start: 3rem;
    padding-block-start: 1rem;
    border-block-start: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .session-pager-side {
    flex: 1;
    min-width: 0;
  }

  .session-pager-side-next {
    text-align: right;
  }

  .session-pager a {
    display: inline-flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .session-pager-direction {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .session-pager-title {
    font-size: 1rem;
  }
</style>
