---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description={`The twelve-week teaching schedule: what happens in each ${sessionLabels.singular.toLowerCase()}, what to prepare, and what leaves the room.`}
  heroImage="/src/assets/banners/sessions.svg"
  heroImageAlt=""
  {...siteConfig}
>
  <p>
    The course meets for one four-hour studio block a week, on a single
    afternoon. Most weeks open with an hour of lecture before the room turns
    into hands-on tutorial time for the rest of the block; crit and clinic
    weeks run hands-on throughout, with no separate lecture. Each card below
    is that week's actual runsheet — what to bring, what happens in the room,
    and what you leave with.
  </p>
  <SessionsGrid />
</ContentLayout>
